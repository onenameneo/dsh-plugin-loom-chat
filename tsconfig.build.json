{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "declarationDir": "lib/types",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "src/index.ts",
    "src/invariant.ts",
    "src/client/index.ts",
    "src/css-modules.d.ts",
    "src/vendor/dsh-harness-optional-modules.d.ts"
  ],
  "exclude": ["tests", "lib", "node_modules"]
}
